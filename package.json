{
  "name": "haldoz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/tool.mjs next dev --hostname 127.0.0.1 --port 3100",
    "build": "node scripts/tool.mjs next build --webpack",
    "start": "node scripts/tool.mjs next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node scripts/tool.mjs next typegen --webpack && tsc --noEmit",
    "test": "node --liftoff-only --wasm-num-compilation-tasks=1 --test --test-concurrency=1 tests/*.test.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:public-source": "node scripts/check-public-source.mjs",
    "check": "node scripts/check.mjs",
    "verify:http": "node scripts/verify-http.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "npm run deploy:production",
    "check:cloudflare": "node scripts/check-cloudflare.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "deploy:preview": "node scripts/deploy-preview.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "libphonenumber-js": "1.13.15",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "vinext": "1.3.1",
    "react-server-dom-webpack": "19.3.1",
    "@vinext/cloudflare": "1.2.1"
  },
  "overrides": {
    "undici": "7.30.1",
    "fflate": "0.7.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "supabase": "2.121.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "@cloudflare/vite-plugin": "1.65.0",
    "wrangler": "4.152.0"
  }
}
